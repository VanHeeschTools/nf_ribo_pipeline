{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/VanHeeschTools/nf_ribo_pipeline/master/nextflow_schema.json",
    "title": "nf-ribo-pipeline parameters",
    "description": "Ribo-seq pipeline analysis, including filtering, mapping, ORF-calling, harmonisation and expression from RIBO-seq data.",
    "type": "object",
    "defs": {
        "path_specifications": {
            "title": "Path specifications",
            "type": "object",
            "description": "Input and output path defs",
            "default": "",
            "properties": {
                "input": {
                    "type": "string",
                    "schema": "assets/schema_input.json",
                    "format": "file-path",
                    "pattern": "^\\S+\\.csv$",
                    "description": "Path to comma-separated file containing information about the samples in the experiment."
                },
                "project_folder": {
                    "type": "string",
                    "description": "path to folder where outputs and logs will be stored"
                },
                "outdir": {
                    "type": "string",
                    "default": "\"${params.project_folder}/output\"",
                    "description": "name of the output folder"
                }
            },
            "required": [
                "input"
            ]
        },
        "reference_files": {
            "title": "Reference files",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "reference_gtf": {
                    "type": "string",
                    "description": "Reference annotation GTF"
                },
                "reference_fasta": {
                    "type": "string",
                    "description": "Reference genome fasta file"
                },
                "reference_fasta_fai": {
                    "type": "string",
                    "description": "Reference genome fasta fai file"
                },
                "reference_twobit": {
                    "type": "string",
                    "description": "Reference 2bit file"
                },
                "reference_protein_fa": {
                    "type": "string",
                    "description": "Reference protein fasta file"
                },
                "package_install_loc": {
                    "type": "string",
                    "description": "Path to bsgenome library directory"
                },
                "orfquant_annotation": {
                    "type": "string",
                    "description": "Path to Rannot file required for ORFquant"
                },
                "contaminants_fasta": {
                    "type": "string",
                    "description": "Path to contaminants fasta file for Bowtie2 filtering"
                },
                "star_index_path": {
                    "type": "string",
                    "description": "Path to STAR index directory"
                },     
                "bowtie2_index_path": {
                    "type": "string",
                    "description": "Path to Bowtie2 index directory"
                },     
                "price_index_path": {
                    "type": "string",
                    "description": "Path to PRICE index directory"
                },
                "container_folder": {
                    "type": "string",
                    "description": "Path to container location"
                },
                "html_template": {
                    "type": "string",
                    "description": "Path to RiboseQC tempate for RiboseQC reports",
                    "default": "assets/riboseqc_template.Rmd"
                },
                "multiqc_config": {
                    "type": "string",
                    "description": "Path to multiqc yaml config file for custom plots",
                    "default": "assets/multiqc.yaml"
                },        
                "pandoc_dir": {
                    "type": "string",
                    "description": "Location of pandoc_dir",
                    "default": "/usr/src/pandoc/bin"
                },        
                "resource_folder": {
                    "type": "string",
                    "description": "Path to annotation folder"
                },
                "existing_orf_table": {
                    "type": "string",
                    "format": "file-path",
                    "pattern": "^\\S+\\.csv$",
                    "description": "Path to existing ORF table csv to quantify against"
                }
            },
            "required": [
                "reference_gtf",
                "reference_fasta",
                "reference_fasta_fai",
                "reference_twobit",
                "reference_protein_fa",
                "contaminants_fasta",
                "container_folder",
                "html_template",
                "multiqc_config",
                "pandoc_dir",
                "resource_folder"
            ]
        },
        "modules": {
            "title": "Modules",
            "type": "object",
            "description": "Toggles for the different pipeline modules",
            "default": "",
            "properties": {
                "run_selection": {
                    "type": "boolean",
                    "default": true,
                    "description": "Toggle for input filtering and selection modules"
                },
                "run_alignment": {
                    "type": "boolean",
                    "default": true,
                    "description": "Toggle for STAR alignment modules"
                },
                "run_riboseqc": {
                    "type": "boolean",
                    "default": true,
                    "description": "Toggle for RiboseQC modules"
                },
                "run_orfquant": {
                    "type": "boolean",
                    "default": true,
                    "description": "Toggle for ORFquant ORF prediction modules"
                },
                "run_price": {
                    "type": "boolean",
                    "default": true,
                    "description": "Toggle for PRICE ORF prediction modules"
                },
                "run_ribotie": {
                    "type": "boolean",
                    "default": true,
                    "description": "Toggle for RiboTIE module"
                },                
                "run_psite": {
                    "type": "boolean",
                    "default": true,
                    "description": "Toggle for Psite modules"
                },
                "run_annotation": {
                    "type": "boolean",
                    "default": true,
                    "description": "Toggle for ORF annotation modules"
                },
                "run_expression": {
                    "type": "boolean",
                    "default": true,
                    "description": "Toggle for ORF expression modules"
                },
                "run_multiqc": {
                    "type": "boolean",
                    "default": true,
                    "description": "Toggle for MultiQC module"
                },                                                                                                                                 
                "run_qc": {
                    "type": "boolean",
                    "default": true,
                    "description": "Toggle for QC modules"
                },   
                "run_orf_analysis": {
                    "type": "boolean",
                    "default": true,
                    "description": "Toggle for ORF prediction modules"
                },
                "run_quantify_existing":{
                    "type": "boolean",
                    "default": false,
                    "description": "Toggle for ORF quantification on existing ORF list"
                }                                           
            }
        },
        "extended_pipeline_options": {
            "title": "Extended pipeline options",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "validate_gtf_attributes": {
                    "type": "boolean",
                    "description": "Whether check the first 10k rows of the gtf for the correct format and attributes",
                    "default": true
                },
                "keep_bam": {
                    "type": "boolean",
                    "description": "Whether to copy the Alignment BAM files to the output directory or not",
                    "default": true
                },
                "ribotie_min_samples": {
                    "type": "integer",
                    "description": "Minimum amount of samples a RiboTIE ORF needs to occur in to be kept",
                    "default": 2
                },
                "readlength_choice_method": {
                    "type": "string",
                    "description": "The readlength filter choice for RiboseQC defaults to max_coverage, needs to be one of: 'max_coverage','max_inframe','all'.",
                    "enum": ["max_coverage","max_inframe","all"],
                    "default": "max_coverage",
                    "errorMessage": "Needs to be one of: 'max_coverage','max_inframe','all'"
                }
            }
        },
        "specs": {
            "title": "Maximum specifications for computational resources",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "max_memory": {
                    "type": "string",
                    "description": "max memory for each process"
                },
                "max_cpus": {
                    "type": "integer",
                    "description": "max cpus for each process"
                },
                "max_time": {
                    "type": "string",
                    "description": "max time for each process"
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "#/defs/reference_files"
        },
        {
            "$ref": "#/defs/extended_pipeline_options"
        },
        {
            "$ref": "#/defs/modules"
        },
        {
            "$ref": "#/defs/path_specifications"
        },
        {
            "$ref": "#/defs/specs"
        },
        {
            "if": {
                "properties": {
                    "run_quantify_existing": { "const": true }
                },
                "required": ["run_quantify_existing"]
            },
            "then": {
                "properties": {
                    "existing_orf_table": {
                        "type": "string",
                        "format": "file-path",
                        "pattern": "^\\S+\\.csv$"
                    }
                },
                "required": ["existing_orf_table"]
            }
        }
    ]
}