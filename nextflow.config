params {
    // Pipeline steps
    help                   = false

    // Input files and paths
    project_folder         = "./"
    outdir                 = "${params.project_folder}/output"
    input                  = null
    
    // resource_folder     = null
    container_folder       = null // Location where to look for the required containers
    multiqc_config         = "assets/multiqc.yaml"
    html_template          = "assets/riboseqc_template.Rmd"

    // Reference files
    reference_gtf          = null // This can either be a custom transcriptome or a reference GTF
    reference_fasta        = null // Genome assembly in FASTA format
    reference_fasta_fai    = null // Genome assembly FASTA FAI file
    reference_protein_fa   = null // Genome protein file in FASTA format
    reference_twobit       = null // Required for R annotation generation
    contaminants_fasta     = null // Database of known RNA contaminants
    
    // RiboseQC filter mode
    readlength_choice_method = "max_coverage" // This is the default

    // Can be supplied, can also be generated by the pipeline
    package_install_loc    = null // Location where to install BSGenome package for annotation
    orfquant_annotation    = null // R annotation file required for ORFquant
    star_index_path        = null // STAR index path
    bowtie2_index_path     = null // Bowtie2 index path
    price_index_path       = null // PRICE index path
    pandoc_dir             = "/usr/src/pandoc/bin" // Location of pandoc in the given container

    // Optional adapter that can be set for Trimgalore
    adapter                = ""

    // Run quantification on existing ORF list, disables ORF calling
    run_quantify_existing = false
    existing_orf_table = null

    // Pipeline sections to run
    run_qc                  = true
    run_orf_analysis        = true

    // Modules
    run_selection           = true
    run_alignment           = true
    run_riboseqc            = true
    run_orfquant            = true
    run_price               = true
    run_ribotie             = true
    run_psite               = true
    run_annotation          = true
    run_expression          = true
    run_multiqc             = true

}

manifest {
    name            = 'nf_ribo_pipeline'
    author          = 'Edwin van der Werf, Jip van Dinter, Damon Hofman, Leron Kok'
    homePage        = 'https://github.com/VanHeeschTools/nf_ribo_pipeline/'
    defaultBranch   = 'main'
    description     = 'Ribosome profiling pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.4'
    version         = 'v1.0.0'
}

plugins {
    id 'nf-schema@2.0.0'
}

executor {
    $slurm {
        queueSize = 50
        pollInterval = '30sec'
        queueStatInterval = '5min'
    }
}

profiles {
    local {
        process.executor = 'local'
        process.cpus     = 2
        process.memory   = '10GB'
    }
    slurm {
        process.executor  = 'slurm'
        process.queue     = 'cpu'
        process.clusterOptions = "--constraint=avx2"
    }
}

singularity {
    enabled    = true
    autoMounts = true
    pull       = 'never'
}


// Execution reports
// Create unique log files using the timestamp
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

timeline {
    enabled = true
    overwrite = true
    file = "${params.project_folder}/log/timeline_${trace_timestamp}.html"
}

report {
    enabled = true
    overwrite = true
    file = "${params.project_folder}/log/report_${trace_timestamp}.html"
}

trace {
    enabled = true
    overwrite = true
    file = "${params.project_folder}/log/trace_${trace_timestamp}.txt"
}

includeConfig 'configs/base.config'
